{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Atrix Installer",
  "mainBinaryName": "atrix-installer",
  "version": "../../../package.json",
  "identifier": "com.arixlab.atrix.installer",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:1470",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "windows": {
      "staticVCRuntime": true
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Atrix",
        "width": 560,
        "height": 600,
        "resizable": false,
        "maximizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "publisher": "ArixLab",
    "active": true,
    "targets": ["appimage", "dmg"],
    "icon": [
      "../../../src-tauri/icons/32x32.png",
      "../../../src-tauri/icons/128x128.png",
      "../../../src-tauri/icons/128x128@2x.png",
      "../../../src-tauri/icons/icon.icns",
      "../../../src-tauri/icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
