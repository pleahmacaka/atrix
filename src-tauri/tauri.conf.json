{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Atrix",
  "version": "0.2.0",
  "identifier": "com.arixlab.atrix",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:1460",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Atrix",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/.atrix/pcb/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
