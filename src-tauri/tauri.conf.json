{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Atrix",
  "version": "0.4.24",
  "identifier": "com.arixlab.atrix",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:1460",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Atrix",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --enable-smooth-scrolling"
      },
      {
        "label": "overlay",
        "create": false,
        "url": "/overlay",
        "title": "Atrix",
        "width": 344,
        "height": 104,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --enable-smooth-scrolling"
      },
      {
        "label": "float",
        "create": false,
        "url": "/float",
        "title": "Atrix",
        "width": 520,
        "height": 760,
        "minWidth": 360,
        "minHeight": 420,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --enable-smooth-scrolling"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/.atrix/pcb/**"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYxQ0Q0NjY1QTQ0MzhBRUUKUldUdWlrT2taVWJOOFNJaW12d2FqVmlmSjU4Y1ZDc2FYdUV5UVBqcnlqb01vR1A4bzlkT1NPVUoK",
      "endpoints": [
        "https://github.com/pleahmacaka/atrix/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "../scripts/": "scripts/",
      "../src/lib/pcb/types.ts": "src/lib/pcb/types.ts"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
